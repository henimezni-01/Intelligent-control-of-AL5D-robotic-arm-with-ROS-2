    <origin xyz="-4.05231e-15 0.146277 0.0025433" rpy="-3.14159 1.57164e-15 -1.95055"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="60" velocity="6.0"/> 
</joint>

<joint name="wrist_1_joint" type="revolute">
    <parent link="elbow_link"/>
    <child link="wrist_link"/>
    <origin xyz="-0.180651 -0.0046142 -0.0542165" rpy="-1.52122e-16 -2.12933e-16 -2.12063"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="20" velocity="6.0"/> 
</joint>

<joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_link"/>
    <child link="hand_link"/>
    <origin xyz="0.056936 3.375e-05 0.0305835" rpy="1.5708 -1.54861 -1.5708"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="20" velocity="6.0"/> 
</joint>

<joint name="gripper_left_joint" type="prismatic">
    <parent link="hand_link"/>
    <child link="gripper_left_link"/>
    <origin xyz="-0.0189744 0.0064008 -0.0272124" rpy="-3.14159 1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.05" upper="0.05" effort="10" velocity="20"/> 
</joint>

<joint name="gripper_right_joint" type="prismatic">
    <parent link="hand_link"/>
    <child link="gripper_right_link"/>
    <origin xyz="0.0217646 0.0064008 -0.0272124" rpy="0 1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.05" upper="0.05" effort="10" velocity="20"/> 
    <mimic joint="gripper_left_joint" multiplier="1" offset="0"/>
</joint>

