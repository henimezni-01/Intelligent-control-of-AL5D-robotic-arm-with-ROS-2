    <axis xyz="0 0 1"/>
    <limit effort="1000" lower="0.0" upper="3.14" velocity="0.5"/>
  </joint>
  <joint name="wrist_1_joint" type="revolute">
    <parent link="elbow_link"/>
    <child link="wrist_link"/>
    <origin rpy="-1.52122e-16 -2.12933e-16 -2.12063" xyz="-0.180651 -0.0046142 -0.0542165"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000" lower="0.0" upper="3.14" velocity="0.5"/>
  </joint>
  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_link"/>
    <child link="hand_link"/>
    <origin rpy="1.5708 -1.54861 -1.5708" xyz="0.056936 3.375e-05 0.0305835"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000" lower="0.0" upper="3.14" velocity="0.5"/>
  </joint>
  <joint name="gripper_left_joint" type="prismatic">
    <parent link="hand_link"/>
    <child link="gripper_left_link"/>
    <origin rpy="-3.14159 1.5708 0" xyz="-0.0189744 0.0064008 -0.0272124"/>
    <axis xyz="0 0 1"/>
    <limit effort="1" lower="-0.05" upper="0.05" velocity="20"/>
  </joint>
  <joint name="gripper_right_joint" type="prismatic">
    <parent link="hand_link"/>
    <child link="gripper_right_link"/>
    <origin rpy="0 1.5708 0" xyz="0.0217646 0.0064008 -0.0272124"/>
    <axis xyz="0 0 1"/>
    <limit effort="1" lower="-0.05" upper="0.05" velocity="20"/>
  </joint>
  <!-- ====================== -->
  <!-- Transmissions -->
  <!-- ====================== -->
  <transmission name="base_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="base_joint">
      <hardwareInterface>position</hardwareInterface>
    </joint>
    <actuator name="base_actuator">
      <mechanicalReduction>1</mechanicalReduction>
      <hardwareInterface>position</hardwareInterface>
    </actuator>
  </transmission>
  <transmission name="shoulder_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="shoulder_joint">
      <hardwareInterface>position</hardwareInterface>
    </joint>
    <actuator name="shoulder_actuator">
      <mechanicalReduction>1</mechanicalReduction>
      <hardwareInterface>position</hardwareInterface>
    </actuator>
  </transmission>
  <transmission name="elbow_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="elbow_joint">
      <hardwareInterface>position</hardwareInterface>
    </joint>
    <actuator name="elbow_actuator">
      <mechanicalReduction>1</mechanicalReduction>
      <hardwareInterface>position</hardwareInterface>
    </actuator>
  </transmission>
  <transmission name="wrist_1_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="wrist_1_joint">
      <hardwareInterface>position</hardwareInterface>
    </joint>
    <actuator name="wrist_1_actuator">
      <mechanicalReduction>1</mechanicalReduction>
      <hardwareInterface>position</hardwareInterface>
    </actuator>
  </transmission>
  <transmission name="wrist_2_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="wrist_2_joint">
      <hardwareInterface>position</hardwareInterface>
    </joint>
    <actuator name="wrist_2_actuator">
      <mechanicalReduction>1</mechanicalReduction>
      <hardwareInterface>position</hardwareInterface>
    </actuator>
  </transmission>
  <transmission name="gripper_left_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="gripper_left_joint">
      <hardwareInterface>position</hardwareInterface>
    </joint>
    <actuator name="gripper_left_actuator">
      <mechanicalReduction>1</mechanicalReduction>
      <hardwareInterface>position</hardwareInterface>
    </actuator>
  </transmission>
  <transmission name="gripper_right_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="gripper_right_joint">
      <hardwareInterface>position</hardwareInterface>
    </joint>
    <actuator name="gripper_right_actuator">
      <mechanicalReduction>1</mechanicalReduction>
      <hardwareInterface>position</hardwareInterface>
    </actuator>
